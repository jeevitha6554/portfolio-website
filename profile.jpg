&lt;style&gt;
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#0f172a;
    color:white;
}

header{
    text-align:center;
    padding:80px 20px;
    background:linear-gradient(135deg,#2563eb,#7c3aed);
}

header h1{
    font-size:3rem;
    margin-bottom:10px;
}

header p{
    font-size:1.1rem;
}

.container{
    width:90%;
    max-width:1000px;
    margin:auto;
}

.card{
    background:#1e293b;
    padding:25px;
    margin:20px 0;
    border-radius:15px;
}

